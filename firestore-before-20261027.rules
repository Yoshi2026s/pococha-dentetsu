rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{path=**}  { allow read, write: if request.auth != null; }
    match /rooms/{path=**}  { allow read, write: if request.auth != null; }
    match /_locks/{id}      { allow read, write: if request.auth != null; }
    match /players/{uid}    { allow read, write: if request.auth != null && request.auth.uid == uid; }
  }
}
